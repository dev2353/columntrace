# Copy to .env.local (git-ignored) to let the dev server open lineage files from one extra folder:
#   http://localhost:5173/?data=/@fs/<absolute path to lineage.json>
COLUMNTRACE_DATA_DIR=/absolute/path/to/private/output

# Optional: tables always shown, even when a name rule under Filters hides them (comma separated)
# VITE_ALWAYS_SHOW=silver_x.tmp_orders,silver_x.tmp_items
